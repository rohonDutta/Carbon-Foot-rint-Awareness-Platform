{
  "name": "carbonwise-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "2.8.0",
    "@tailwindcss/vite": "4.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "lucide-react": "0.546.0",
    "motion": "12.40.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/express": "4.17.25",
    "@types/node": "22.19.21",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "10.5.0",
    "esbuild": "0.28.1",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.1",
    "tsx": "4.22.4",
    "typescript": "5.8.3",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  }
}
